DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional: sync slash commands to one guild while developing for faster updates.
# DISCORD_GUILD_ID=123456789012345678

PODCAST_RSS_URL=https://example.com/podcast/rss

# Optional: defaults to data/episodes.sqlite3.
# DATABASE_PATH=data/episodes.sqlite3

# Optional: defaults to data/audio.
# AUDIO_DIR=data/audio

# Required for OpenAI transcription/summaries in scheduled refresh jobs.
# OPENAI_API_KEY=replace-with-openai-api-key

# Optional local scheduled refresh/deploy settings.
# REFERENCE_REFRESH_LIMIT=3
# REFERENCE_DEPLOY_REMOTE=origin
# REFERENCE_DEPLOY_BRANCH=main
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/...
