DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional: post one announcement after a new episode transcript and summary complete.
# Defaults to the verified `一般` channel; override when deploying to another server.
# DISCORD_ANNOUNCEMENT_CHANNEL_ID=1511396029369548804
# PODCAST_SPOTIFY_URL=https://open.spotify.com/show/7eG1p84LghCfWPqzv2Dwts
# PODCAST_APPLE_PODCASTS_URL=https://podcasts.apple.com/podcast/1517351878

# Optional: sync slash commands to one or more guilds while developing for faster updates.
# DISCORD_GUILD_IDS=123456789012345678,234567890123456789

PODCAST_RSS_URL=https://example.com/podcast/rss

# Optional: defaults to data/episodes.sqlite3.
# DATABASE_PATH=data/episodes.sqlite3

# Railway production uses the SQLite corpus bundled into the Docker image.
# DATABASE_PATH=/app/data/episodes.sqlite3

# Optional: defaults to data/audio.
# AUDIO_DIR=data/audio

# Required for OpenAI transcription/summaries in scheduled refresh jobs.
# OPENAI_API_KEY=replace-with-openai-api-key

# Optional local scheduled refresh/deploy settings.
# REFERENCE_REFRESH_LIMIT=3
# REFERENCE_DEPLOY_REMOTE=origin
# REFERENCE_DEPLOY_BRANCH=main
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/...
